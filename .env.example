# Copy this file to `.env` and fill in your own EVDC account.
# `.env` is git-ignored; never commit real credentials.

# EVDC account (email/password; social logins have no EVDC password).
EVDC_EMAIL=you@example.com
EVDC_PASSWORD=your_password

# Stable device id: a 64-hex string identifying this client to EVDC.
# Generate it ONCE and keep it here, so every run looks like the same device
# instead of registering a new one each time:
#   python -c "import secrets; print(secrets.token_hex(32))"
EVDC_DEVICE_ID=

# Optional: directory where usage.py saves the latest session's PDF receipt.
# EVDC_RECEIPT_DIR=./receipts
